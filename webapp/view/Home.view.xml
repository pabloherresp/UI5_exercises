<mvc:View
    controllerName="com.xtendhr.hello.controller.Home"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
	xmlns:l="sap.ui.layout"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <Panel
            id="panel_0"
            headerText="{i18n>exercise_1}"
            expandable="true"
        >
            <content>
			<l:VerticalLayout >
			<l:HorizontalLayout >
                <Button
                    class="btnHello"
                    id="helloWorldButton"
                    text="{i18n>txt}"
                />
                <Button
                    class="btnHello"
                    id="hideButton"
                    text="{i18n>btnHideTxt}"
                    icon="sap-icon://hide"
                />
                <Button
                    class="btnHello"
                    id="showButton"
                    text="{i18n>btnShowTxt}"
                    icon="sap-icon://show"
                />
			</l:HorizontalLayout>
			<l:HorizontalLayout >
                <Input
                    class="inputText"
                    value=""
                    id="input_0"
                />
                <Input
                    class="inputText"
                    value="{/value}"
                    id="input_1"
                />
                <Input
                    class="inputText"
                    value="{data>/value}"
                    id="input_2"
                />
			</l:HorizontalLayout>
			</l:VerticalLayout>
            </content>
        </Panel>
		<Panel 
			id="panel_1"
			headerText="{i18n>exercise_2}"
			expandable="true"
			expanded="true"
		>
		<l:VerticalLayout >
			<Image id="image_0" src="https://i.ytimg.com/vi/m-wbguWlt9w/maxresdefault.jpg" width="400px"/>
			<Button id="imageButton" class="btnHello" text="{i18n>btnHideTxt}" icon="sap-icon://hide"/>
		</l:VerticalLayout>
		</Panel>
    </Page>
</mvc:View>
